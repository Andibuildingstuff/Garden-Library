# Copy to .env and fill in, or just export these in your shell before `npm start`.

# Required for photo identification. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# A shared code required by the paid routes. Optional locally; essential once
# deployed, or anyone who finds the URL can spend your API credit. Any hard-to-
# guess string will do.
ACCESS_CODE=

# Optional
PORT=3000
